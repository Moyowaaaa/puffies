# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public-safe; Row Level Security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-side only (Netlify Functions). Never prefix with VITE_.
# STRIPE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Mock vs live is toggled in Admin → Settings (stored in the browser).
